<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- The application manifest of every Windows executable Zodiac ships or builds: zodiac.exe, zodiacw.exe and every game (zodiac build links
lib/release/zodiac_manifest.obj, compiled from application.rc). Owner decision, Task 5c fix round 1: the process heap, and so the C runtime's
heap, is the Segment Heap. Windows 10 2004 (build 19041) and later honour heapType; older Windows ignores the element and keeps the NT heap,
as before. trustInfo (Task 5c fix round 2) runs every one of them as the user who starts it (asInvoker): without it, Windows' installer
detection would ask for elevation for a game named setup, update, patch or install. A later entry (DPI awareness, the UTF-8 code page,
supportedOS) goes into this same file. It is the executables' one manifest: no other resource script of an executable may emit an
RT_MANIFEST resource 1 (CREATEPROCESS_MANIFEST_RESOURCE_ID), or the link would carry two. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
<trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
<security>
<requestedPrivileges>
<requestedExecutionLevel level="asInvoker" uiAccess="false"/>
</requestedPrivileges>
</security>
</trustInfo>
<application xmlns="urn:schemas-microsoft-com:asm.v3">
<windowsSettings>
<heapType xmlns="http://schemas.microsoft.com/SMI/2020/WindowsSettings">SegmentHeap</heapType>
</windowsSettings>
</application>
</assembly>
