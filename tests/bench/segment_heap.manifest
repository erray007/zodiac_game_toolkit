<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- bench_types' manifest in the Segment Heap arm of the allocator experiment (ZODIAC_BENCH_ALLOCATOR=segment, Task 5c): the process
heap, and so the C runtime's heap, is a segment heap (Windows 10 2004 and later). No shipped executable carries it. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
<application xmlns="urn:schemas-microsoft-com:asm.v3">
<windowsSettings>
<heapType xmlns="http://schemas.microsoft.com/SMI/2020/WindowsSettings">SegmentHeap</heapType>
</windowsSettings>
</application>
</assembly>
