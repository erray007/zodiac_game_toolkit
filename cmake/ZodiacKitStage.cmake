# zodiac_kit_stage()
#
# Windows only. Creates the target zodiac_kit_stage, which lays the build tree out as a runnable kit around bin/zodiac.exe (see core/kit_layout.hpp),
# and makes every zodiac build depend on it:
# - lib/release/: libzodiac_release_stub.a, libzodiac_core_release.a, libangelscript.a, zodiac_manifest.obj (the application manifest
#   resource every game links: the Segment Heap, asInvoker), zodiac_manifest_admin.obj (the same with requireAdministrator, linked instead with [release] run_as_admin), and crt/ with every toolchain file the captured link line names (ZODIAC_RELEASE_CRT_FILES,
#   from zodiac_capture_release_link, which also writes link.txt and toolchain.txt there; call it first).
# - bin/: ld.lld.exe from the toolchain, with the toolchain DLLs it loads (found through llvm-objdump's import tables, transitively), because the
#   toolchain's ld.lld.exe is not self-contained (it loads libLLVM-<n>.dll and libc++.dll from its own folder).
# - modules/static/: zodiac_mod_<name>.a for every module zodiac_add_module built with a static variant (renamed from libzodiac_mod_<name>_static.a),
#   and zodiac_mod_<name>.stamp holding the toolchain.txt text, which zodiac build checks third-party static modules against.
# It also installs exactly those staged files (bin, lib/release, lib/release/crt, and modules/static for the modules listed in the global property
# ZODIAC_SHIPPED_MODULES, see modules/CMakeLists.txt) from the lists it staged them from.
# Call it after every zodiac_add_module call, so every static module is staged.
include_guard(GLOBAL)
function(zodiac_kit_stage)
set(release_lib "${CMAKE_BINARY_DIR}/lib/release")
set(bin "${CMAKE_BINARY_DIR}/bin")
set(static_dir "${CMAKE_BINARY_DIR}/modules/static")
set(toolchain_txt "${release_lib}/toolchain.txt")
if(NOT EXISTS "${toolchain_txt}")
message(FATAL_ERROR "zodiac_kit_stage: ${toolchain_txt} is missing; call zodiac_capture_release_link first.")
endif()
set(outputs "")
set(install_bin "")
set(install_lib "")
set(install_crt "")
set(install_static "")
foreach(target zodiac_release_stub zodiac_core_release angelscript)
set(staged "${release_lib}/lib${target}.a")
add_custom_command(OUTPUT "${staged}" COMMAND "${CMAKE_COMMAND}" -E copy "$<TARGET_FILE:${target}>" "${staged}" DEPENDS ${target} VERBATIM)
list(APPEND outputs "${staged}")
list(APPEND install_lib "${staged}")
endforeach()
# The application manifest objects (src/platform/windows/application.manifest.in, one per execution level): zodiac build links
# zodiac_manifest.obj (asInvoker) into every game, or zodiac_manifest_admin.obj (requireAdministrator) with [release] run_as_admin.
foreach(pair "zodiac_application_manifest;zodiac_manifest.obj" "zodiac_application_manifest_admin;zodiac_manifest_admin.obj")
list(GET pair 0 object_target)
list(GET pair 1 object_name)
set(staged "${release_lib}/${object_name}")
add_custom_command(OUTPUT "${staged}" COMMAND "${CMAKE_COMMAND}" -E copy "$<TARGET_OBJECTS:${object_target}>" "${staged}" DEPENDS ${object_target} "${CMAKE_SOURCE_DIR}/src/platform/windows/application.manifest.in" VERBATIM COMMAND_EXPAND_LISTS)
list(APPEND outputs "${staged}")
list(APPEND install_lib "${staged}")
endforeach()
foreach(file IN LISTS ZODIAC_RELEASE_CRT_FILES)
cmake_path(GET file FILENAME name)
set(staged "${release_lib}/crt/${name}")
add_custom_command(OUTPUT "${staged}" COMMAND "${CMAKE_COMMAND}" -E copy "${file}" "${staged}" DEPENDS "${file}" VERBATIM)
list(APPEND outputs "${staged}")
list(APPEND install_crt "${staged}")
endforeach()
# ld.lld.exe and the toolchain DLLs it needs, transitively; system DLLs (not in the toolchain's bin folder) are left to Windows.
cmake_path(GET CMAKE_CXX_COMPILER PARENT_PATH toolchain_bin)
set(objdump "${toolchain_bin}/llvm-objdump.exe")
set(pending "ld.lld.exe")
set(runtime "")
while(pending)
list(POP_FRONT pending name)
string(TOLOWER "${name}" name_key)
if(name_key IN_LIST runtime)
continue()
endif()
list(APPEND runtime "${name_key}")
set(file "${toolchain_bin}/${name}")
execute_process(COMMAND "${objdump}" -p "${file}" RESULT_VARIABLE result OUTPUT_VARIABLE dump ERROR_VARIABLE dump_error)
if(NOT result EQUAL 0)
message(FATAL_ERROR "zodiac_kit_stage: cannot read the imports of ${file}: ${dump_error}")
endif()
string(REGEX MATCHALL "DLL Name: [^\r\n]+" imports "${dump}")
foreach(import IN LISTS imports)
string(REGEX REPLACE "^DLL Name: " "" import "${import}")
string(STRIP "${import}" import)
if(EXISTS "${toolchain_bin}/${import}")
list(APPEND pending "${import}")
endif()
endforeach()
set(staged "${bin}/${name}")
add_custom_command(OUTPUT "${staged}" COMMAND "${CMAKE_COMMAND}" -E copy "${file}" "${staged}" DEPENDS "${file}" VERBATIM)
list(APPEND outputs "${staged}")
list(APPEND install_bin "${staged}")
endwhile()
get_property(static_modules GLOBAL PROPERTY ZODIAC_STATIC_MODULES)
get_property(shipped_modules GLOBAL PROPERTY ZODIAC_SHIPPED_MODULES)
foreach(module IN LISTS static_modules)
set(archive "${static_dir}/zodiac_mod_${module}.a")
set(stamp "${static_dir}/zodiac_mod_${module}.stamp")
add_custom_command(OUTPUT "${archive}" COMMAND "${CMAKE_COMMAND}" -E copy "$<TARGET_FILE:zodiac_mod_${module}_static>" "${archive}" DEPENDS zodiac_mod_${module}_static VERBATIM)
add_custom_command(OUTPUT "${stamp}" COMMAND "${CMAKE_COMMAND}" -E copy "${toolchain_txt}" "${stamp}" DEPENDS "${toolchain_txt}" VERBATIM)
list(APPEND outputs "${archive}" "${stamp}")
if(module IN_LIST shipped_modules)
list(APPEND install_static "${archive}" "${stamp}")
endif()
endforeach()
add_custom_target(zodiac_kit_stage DEPENDS ${outputs})
add_dependencies(zodiac zodiac_kit_stage)
# "cmake --install" copies exactly the files staged above, from the same lists, never a whole staged folder, so a stale file left in the build
# tree cannot reach the kit. The tools (zodiac.exe, zodiacw.exe), the shipped modules, the headers and the documents have their own install rules.
install(FILES ${install_bin} DESTINATION bin)
install(FILES ${install_lib} "${release_lib}/link.txt" "${toolchain_txt}" DESTINATION lib/release)
install(FILES ${install_crt} DESTINATION lib/release/crt)
install(FILES ${install_static} DESTINATION modules/static)
endfunction()
